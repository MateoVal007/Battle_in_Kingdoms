# Unity: basado en github/gitignore/Unity.gitignore
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/
# Herramientas y archivos regenerados por Unity/IDE
.vs/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.pdb.meta
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
*.log
/sysinfo.txt
/crashlytics-build.properties
/Assets/Plugins/Editor/JetBrains*
# Exportaciones generadas; conservar sus fuentes
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
# Respaldo automatico temporal de Unity
/Assets/_Recovery/
/Assets/_Recovery.meta
# Fuentes .glb crudas ya respaldadas en JUEGO_FINAL/Modelos (Unity usa los .fbx/.obj optimizados)
Assets/07_Models/**/*.glb
Assets/07_Models/**/*.glb.meta
*.app/
# Backups de herramientas, no modelos originales
*.blend1
*.blend2
*.orig
*.rej
*.tmp
*.swp
.DS_Store
Thumbs.db
Desktop.ini
# Credenciales locales: no excluir indiscriminadamente configuracion compartida
.env
.env.*
!.env.example
*.keystore
*.jks
*.pfx
*.p12
# Assets, .meta, Packages y ProjectSettings SI se versionan.
# No ignorar *.dll: pueden ser dependencias reales dentro de Assets/Plugins.
